# Git
.git/

# dist/unotusk-installer.tar.gz(.sha256) is committed intentionally — Vercel
# serves it at install.unotusk.com/dist/... for bootstrap/install.sh to fetch
# from a private repo without GitHub auth. Rebuilt by scripts/release.sh.

# Secrets — never commit
.env
.secrets
*.key
*.crt
*.pem
*.csr
*.srl

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Logs
*.log

# Session/work logs (logs/*.md) — deliberately local-only, never committed.
# This repo is public (since 2026-08-03); a full history scrub was needed
# once after these accumulated too much internal detail (vulnerability
# specifics, architecture internals) for a public repo. Keep them out of
# git entirely going forward — local reference only.
logs/

# Temporary
tmp/
TMP_*/
