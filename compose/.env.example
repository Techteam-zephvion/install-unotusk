# UNOTUSK Customer Stack — Environment Variables
# Copy this file to .env and fill in required values.
# The installer generates and fills these automatically.
#
# Required fields are marked with: # REQUIRED
# Optional fields have sensible defaults.

# ── Organisation ───────────────────────────────────────────────────────────────
ORG_ID=                    # REQUIRED — UUID, generated by installer
ORG_NAME=                  # REQUIRED — e.g. "Acme Corp"
COMPANY_NAME=              # Display name (defaults to ORG_NAME)

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=unotusk
POSTGRES_PASSWORD=         # REQUIRED — strong random password
POSTGRES_DB=unotusk

# ── Vector store ───────────────────────────────────────────────────────────────
QDRANT_API_KEY=            # Optional — leave empty for no auth (dev only)

# ── Platform connection (UPS → cloud, outbound only) ──────────────────────────
# UPS calls Platform's ValidateLicense gRPC on this endpoint.
PLATFORM_URL=https://platform.unotusk.com:50051    # REQUIRED
PLATFORM_LICENSE_KEY=                               # REQUIRED — from Zephvion sales
LICENSE_HEARTBEAT_INTERVAL=60                       # seconds
LICENSE_GRACE_PERIOD=18000                          # 5 hours before degraded mode

# ── Signed-token trust (US → UPS → Platform) ─────────────────────────────────
PLATFORM_TOKEN_AUDIENCE=platform.unotusk.com
PLATFORM_JWKS_PUSH_URL=   # REQUIRED — https://platform.unotusk.com/internal/orgs/<ORG_ID>/jwks
JWKS_PUSH_SECRET=          # REQUIRED — shared secret for JWKS push endpoint

# ── Integrations ───────────────────────────────────────────────────────────────
GITHUB_ORG_NAME=           # Optional — GitHub org for AI-PIE code analysis
JIRA_URL=                  # Optional — e.g. https://acme.atlassian.net

# ── OIDC / SSO ────────────────────────────────────────────────────────────────
OIDC_ISSUER=               # Optional — e.g. https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=            # Optional — from your IdP app registration
# OIDC_CLIENT_SECRET is stored in .secrets (chmod 600), not here

# ── Versioning ────────────────────────────────────────────────────────────────
UNOTUSK_VERSION=latest     # Docker image tag — e.g. v1.0.0 or latest

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info             # info | debug | warn | error
