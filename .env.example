# UNOTUSK customer-local stack — root-level variables read by
# docker-compose.yml itself (Postgres bootstrap credentials, cross-service
# URLs, Platform connection details). Copy to `.env` in this directory.
#
# This file does NOT replace each service's own .env — US, UPS, and AI-PIE
# still read their full configuration from US/.env, UPS/.env, AI-PIE/.env
# (copy each from that service's own .env.example). Only the variables
# listed here are referenced directly by docker-compose.yml; a handful of
# them (marked below) override or feed values in the per-service .env files
# so the containers can find each other on the unotusk_internal network.

# ── PostgreSQL (shared instance; separate `auth` and `company` databases
#    are created automatically by scripts/init-databases.sh on first boot) ──
POSTGRES_USER=unotusk
# required — no default, compose fails fast if unset
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ── Qdrant (AI PIE vector store) ─────────────────────────────────────────
QDRANT_API_KEY=

# ── Logging (applied to US, UPS; AI-PIE's own .env controls its own log
#    level separately) ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Platform connection (UPS -> cloud, outbound only) ────────────────────
# gRPC endpoint of the Unotusk Platform's ClientService (Render-hosted).
# UPS calls ValidateLicense on this on every heartbeat.
PLATFORM_URL=https://platform.unotusk.com:50051
# This installation's license key, issued once by Platform when the
# customer's Client record was created (UP's CreateClient). Not a secret
# in the cryptographic sense, but treat it as sensitive — it identifies
# and authorizes this deployment.
PLATFORM_LICENSE_KEY=
# How often UPS calls Platform's ValidateLicense (seconds).
LICENSE_HEARTBEAT_INTERVAL=60
# How long UPS tolerates being unable to reach/validate against Platform
# before entering Degraded Mode (seconds; 18000 = 5 hours per
# UNOTUSK_LICENSE_DEGRADED_MODE.md).
LICENSE_GRACE_PERIOD=18000
#
# In addition to the above, place Platform-issued mTLS material (distinct
# from the shared local dev CA used for US<->UPS<->UAC) at:
#   UPS/certs/platform/ca.crt      — Platform's root CA
#   UPS/certs/platform/client.crt  — this instance's Platform client cert
#   UPS/certs/platform/client.key  — this instance's Platform client key
# These are provisioned during customer onboarding, alongside the license
# key above.

# ── AMEND-014: signed-token trust (US -> UPS -> Platform, outbound only) ──
# US signs short-lived tokens Platform verifies locally (no callback into
# customer infra, which Platform cannot reach). UPS periodically fetches
# US's JWKS over the internal docker network and pushes it to Platform.
# ORG_ID must match what US's own ORG_ID is set to.
ORG_ID=
# Platform's registration endpoint for this org's JWKS, e.g.
# https://platform.unotusk.com/internal/orgs/<ORG_ID>/jwks
PLATFORM_JWKS_PUSH_URL=
# Shared secret gating that endpoint — generate a real random value per
# environment (e.g. `openssl rand -hex 32`), never reuse across customers.
JWKS_PUSH_SECRET=
# Must match US's own PLATFORM_TOKEN_AUDIENCE (defaults to
# platform.unotusk.com on both sides if left unset).
PLATFORM_TOKEN_AUDIENCE=platform.unotusk.com

# ─────────────────────────────────────────────────────────────────────────
# Reference: variables each service's OWN .env must set (not read by
# docker-compose.yml directly — see US/.env.example and UPS/.env.example
# for the authoritative, complete list with every optional var documented).
# ─────────────────────────────────────────────────────────────────────────
#
# US (see US/.env.example for full list)
#   DATABASE_URL           overridden by compose to point at `postgres`/auth
#   ORG_ID / ORG_NAME       required — this deployment's org identity
#   OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_REDIRECT_URL
#                           required — enterprise IdP (or local Keycloak)
#   TOKEN_ENC_KEY           required — openssl rand -base64 32
#   CA_CERT / GRPC_TLS_CERT / GRPC_TLS_KEY   required — mTLS identity
#   PORT                    not used by compose (HTTP_LISTEN_ADDR is set
#                           directly instead); kept for non-compose/manual
#                           runs that still honor Render-style $PORT
#
# UPS (see UPS/.env.example for full list)
#   DATABASE_URL            overridden by compose to point at `postgres`/company
#   AUTH_GRPC_ENDPOINT       overridden by compose to `https://auth-server:50052`
#   ADMIN_USER_IDS           required — Zephvion staff ids allowed admin RPCs
#   CA_CERT / SERVER_TLS_CERT / SERVER_TLS_KEY /
#   AUTH_CLIENT_TLS_CERT / AUTH_CLIENT_TLS_KEY   required — mTLS identity
#
# AI-PIE (see AI-PIE/.env.example for full list)
#   ANTHROPIC_API_KEY, VOYAGE_API_KEY, GITHUB_TOKEN   required
#   QDRANT_URL              overridden by compose to `http://qdrant:6333`
#   PHOENIX_COLLECTOR_ENDPOINT   overridden by compose to `http://phoenix:6006`
#   UPS_LICENSE_STATUS_URL  set by compose to `http://company-server:8080/license/status`
#                           — checked before ingestion/spec/report generation
