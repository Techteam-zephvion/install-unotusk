# Unotusk MVP Stage 0 Environment Configuration

APP_ENV=development
DEBUG=true

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unotusk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unotusk
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unotusk

# Redis & Task Worker
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security (JWT & Password Hashing)
# Replace with a cryptographically secure random string in production (e.g. openssl rand -hex 32)
AUTH_SECRET=dev-secret-change-in-production-min-32-chars-long

# Host Port Mappings (Optional overrides if local ports are already bound)
API_PORT=8000
WEB_PORT=3000

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# LLM Provider Configuration ('groq', 'claude', or 'offline')
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
